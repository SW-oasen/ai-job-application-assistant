# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOG_LEVEL=INFO

# External services: use Docker DNS names inside the shared network.
DIFY_BASE_URL=http://api:5001
# API key of the published "import CV PDF" workflow. Keep the real value in .env only.
DIFY_CV_WORKFLOW_API_KEY=
DIFY_CV_WORKFLOW_TIMEOUT_SECONDS=300
# API key of the published "matching v3" workflow. It does not need to be a workflow tool.
DIFY_MATCHING_WORKFLOW_API_KEY=
DIFY_MATCHING_WORKFLOW_TIMEOUT_SECONDS=300
# API key of the published semantic job-metadata fallback workflow.
DIFY_METADATA_WORKFLOW_API_KEY=
DIFY_METADATA_WORKFLOW_TIMEOUT_SECONDS=120
SEMANTIC_METADATA_MAX_CHARACTERS=15000
MINERU_BASE_URL=http://mineru-api:8000
MINERU_TIMEOUT_SECONDS=300
MINERU_BACKEND=pipeline

# Create the application_assistant database before enabling persistence.
# Never commit the real password.
DATABASE_URL=postgresql+psycopg://postgres:change-me@db_postgres:5432/application_assistant
REDIS_URL=redis://redis:6379/0

# URL import
URL_IMPORT_TIMEOUT_SECONDS=30
URL_IMPORT_MAX_BYTES=10000000
URL_IMPORT_MIN_TEXT_LENGTH=500
URL_IMPORT_MAX_REDIRECTS=5
URL_IMPORT_USER_AGENT=ApplicationAssistant/0.1 (+local)
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_TIMEOUT_SECONDS=45
PDF_IMPORT_MAX_BYTES=20000000
PDF_IMPORT_MIN_TEXT_LENGTH=500
HTML_IMPORT_MAX_BYTES=30000000
APPLICATION_DOCUMENTS_PATH=/app/data/application-documents
APPLICATION_DOCUMENT_MAX_BYTES=20000000

# Existing local Dify network; override for other environments.
DOCKER_NETWORK_NAME=docker_default
